# Flask
FLASK_ENV=development
DEBUG=False
# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

HOST=127.0.0.1
PORT=8000

# Model (required for production)
MODEL_DIR=./sentiment_model
MODEL_NAME=distilbert-base-uncased

# When IMDB weights are missing: auto-set in FLASK_ENV=development (make serve).
# Override explicitly for production demos without local weights:
# HUB_MODEL_FALLBACK=distilbert-base-uncased-finetuned-sst-2-english
# Pin Hugging Face hub revision (supply-chain hardening)
# HF_MODEL_REVISION=main

# Never use in production (random classifier head)
# ALLOW_UNTRAINED_BASE=false

# Data paths (defaults: data/raw/*.csv)
# TRAIN_DATA_PATH=./data/raw/train.csv
# VAL_DATA_PATH=./data/raw/val.csv
# TEST_DATA_PATH=./data/raw/test.csv

# Inference
BATCH_SIZE=32
MAX_TEXT_LENGTH=10000
MAX_SEQUENCE_LENGTH=256

# Metrics API: 0 = full split; set e.g. 1000 for faster live recompute
METRICS_MAX_ROWS=0
BOOTSTRAP_SAMPLES=500

# Security & ops
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Local dev: False (make serve sets this). Production: True with higher limits.
RATE_LIMIT_ENABLED=False
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_PREDICT_PER_MINUTE=30
RATE_LIMIT_COMPUTE_PER_MINUTE=20
CACHE_ENABLED=True
LOG_LEVEL=INFO
LOG_FILE=app.log
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=csv

# Developer API keys (comma-separated). Demo key enabled when API_KEYS_DEMO=true
# API_KEYS=csk_live_your_production_key
API_KEYS_DEMO=true
# API_KEY_DEMO=csk_demo_cinesentiment_local
# DEVELOPER_DAILY_LIMIT=500
# PRO_DAILY_LIMIT=10000

# Optional Redis for rate limiting across workers (default: memory://)
# REDIS_URL=redis://127.0.0.1:6379/0

# Multilingual reviews (XLM-RoBERTa — loaded lazily on non-English text)
# HUB_MODEL_MULTILINGUAL=cardiffnlp/twitter-xlm-roberta-base-sentiment

# Stripe Pro billing (optional — demo mode issues keys without Stripe)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# APP_BASE_URL=https://your-domain.com

# Aspect ML classifier (run: make aspect-train)
# ASPECT_MODEL_PATH=./artifacts/models/aspect_classifier.joblib

# MLOps — MLflow + Weights & Biases
# MLFLOW_TRACKING_URI=./artifacts/mlruns
# MLFLOW_ENABLED=true
# WANDB_ENABLED=true
# WANDB_PROJECT=cinesentiment
# WANDB_MODE=disabled

# LLM zero-shot baseline (make llm-baseline)
# OPENAI_API_KEY=sk-...
# LLM_BASELINE_MODEL=gpt-4o-mini

# Observability
# PROMETHEUS_ENABLED=true
# OTEL_ENABLED=false

# LangGraph agent (POST /api/agent/analyze)
# AGENT_ENABLED=true

# Inference backend: local | vllm | triton
# INFERENCE_BACKEND=local
# VLLM_BASE_URL=http://127.0.0.1:8002/v1
# VLLM_MODEL=meta-llama/Llama-3.2-1B-Instruct
# TRITON_URL=http://127.0.0.1:8003
# TRITON_MODEL=distilbert_sentiment

# Feast feature store
# FEAST_ENABLED=true
